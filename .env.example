# Repo-level reference only. Each app has its own .env.example with the
# variables it actually reads:
#   apps/api/.env.example  (copy to apps/api/.env)
#   apps/web/.env.example  (copy to apps/web/.env.local)
#
# docker-compose.yml sets these directly and does not read this file.

# --- General ---
NODE_ENV=development

# --- apps/api ---
DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics_compliance

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
